<p>Ajouter une formation / Takwin jdid</p>
<input id="titre" placeholder="Nom de la formation">
<textarea id="desc" placeholder="Description"></textarea>
<input id="prix" placeholder="Prix - ex: 500 MAD">
<button onclick="ajouter()">Ajouter la formation</button>
<div id="liste"></div>
<script>
let formations = JSON.parse(localStorage.getItem('formations')||'[]');
function afficher(){document.getElementById('liste').innerHTML = formations.map((f,i)=>`<div class="card"><b>${f.titre}</b><p>${f.desc} - ${f.prix}</p><button onclick="supp(${i})">Supprimer</button></div>`).join('') || '<p>Aucune formation</p>'}
function ajouter(){let t=document.getElementById('titre').value; let d=document.getElementById('desc').value; let p=document.getElementById('prix').value; if(!t) return alert('Kteb smiya'); formations.push({titre:t,desc:d,prix:p}); localStorage.setItem('formations',JSON.stringify(formations)); afficher(); alert('Tzadet!');}
function supp(i){formations.splice(i,1); localStorage.setItem('formations',JSON.stringify(formations)); afficher();}
afficher();
</script>
